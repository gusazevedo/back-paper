# Copy to supabase/functions/.env for local development (`supabase start` / `functions serve`).
# Locally, the Supabase Storage S3 endpoint stands in for Cloudflare R2.
STORAGE_S3_ENDPOINT=http://host.docker.internal:54321/storage/v1/s3
# What the phone uploads to; with `adb reverse tcp:54321 tcp:54321` the emulator reaches it on 127.0.0.1.
STORAGE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_REGION=local
# From `npx supabase status` (S3_PROTOCOL_ACCESS_KEY_ID / _SECRET). Fixed for the local stack.
STORAGE_S3_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
STORAGE_S3_SECRET_ACCESS_KEY=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
STORAGE_BUCKET=wallpapers

# Production (Cloudflare R2), set with `supabase secrets set`:
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID / STORAGE_S3_SECRET_ACCESS_KEY = R2 API token
# STORAGE_BUCKET=<bucket>

# Shared with pg_cron (Vault secret `r2_deletions_secret`) to call process-r2-deletions.
# Locally it matches supabase/seed.sql; in production use a long random value in both places.
R2_DELETIONS_SECRET=local-r2-deletions-secret
